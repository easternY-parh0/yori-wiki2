# SvelteKit 서버에서만 사용하는 backend 주소
BACKEND_URL=http://127.0.0.1:8080
# HTTPS 역방향 프록시 뒤에서는 외부 출처 지정 (BASE_PATH는 포함하지 않음).
# 비워두면 요청 URL의 출처 사용. 개발 시 .env 또는 프로세스 환경에서 읽습니다.
PUBLIC_ORIGIN=
# BASE_PATH와 ALLOWED_HOSTS는 .env가 아닌 셸/systemd 환경 변수로 설정하세요.
# 설정 파일을 먼저 읽는 svelte-kit sync/check와 Vite가 같은 값을 사용해야 합니다.
